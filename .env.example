# Copy to .env (gitignored). Environment variables win over this file.
# Neon Postgres connection string (keep sslmode=require):
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional switches:
# 0 disables retraining when 25 new molecules accumulate
# TOXION_AUTO_RETRAIN=1
# TOXION_RETRAIN_BATCH=25
# TOXION_CHECKPOINT=results/checkpoints/active.pt
# Force cpu or mps
# TOXION_DEVICE=cpu
# At TRAIN time: cap the per-endpoint false-positive rate instead of using Youden's J
# TOXION_FPR_CAP=0.10
